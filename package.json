{
	"type": "module",
	"version": "0.14.0",
	"name": "pkgsz",
	"description": "Get the size of an npm package",
	"license": "MIT",
	"author": "Konstantin Shutkin",
	"keywords": [
		"npm",
		"package",
		"size",
		"cli",
		"tool",
		"bundle"
	],
	"bin": "index.js",
	"files": [
		"index.js",
		"CHANGELOG.md"
	],
	"readme": "README.md",
	"scripts": {
		"lint": "biome lint index.js",
		"ci:publish": "changeset publish",
		"prepack": "pkgprn",
		"test": "c8 --src=. --all -r=html -r=text node --env-file=ci.env test.js"
	},
	"engines": {
		"node": ">=20.12.0"
	},
	"dependencies": {
		"@niceties/ansi": "^1.1.2",
		"@niceties/draftlog-appender": "^2.1.1",
		"@niceties/logger": "^2.1.1",
		"@niceties/node-parseargs-plus": "^0.6.0",
		"pkgbld": "^2.1.0",
		"pkgprn": "^0.8.4",
		"prompts": "2.4.2",
		"read-package-up": "12.0.0",
		"source-map": "0.8.0",
		"source-map-explorer": "2.5.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@changesets/cli": "3.0.3",
		"@types/node": "^26.6.5",
		"c8": "^12.0.0"
	}
}
